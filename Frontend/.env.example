# Base URL of the backend API (../backend_test) — used for sign-in, photo uploads and the activity feed.
# Trading itself talks to the blockchain directly and does not need it.
VITE_API_URL=http://localhost:5000/api

# Cloudinary — where listing and trade photos are shown from.
# Only the CLOUD NAME goes here: it is public (it appears in every image URL). Never put the
# API key or API secret in this file — they belong in backend_test/.env only.
# Use the same cloud name as CLOUDINARY_CLOUD_NAME in backend_test/.env.
VITE_CLOUDINARY_CLOUD_NAME=
# Optional — only if you changed CLOUDINARY_FOLDER in backend_test/.env (default: trove).
# VITE_CLOUDINARY_FOLDER=trove
# Optional — transformations applied when an image is DELIVERED (the stored original is untouched).
# Default f_auto,q_auto = best format + automatic quality. Set to an empty value to serve the original as-is.
# VITE_CLOUDINARY_TRANSFORM=f_auto,q_auto

# ── Deployed site only (set these in Vercel > Project > Settings > Environment Variables) ──
# Make the site read the public Sepolia chain instead of the local Hardhat node:
# VITE_DEFAULT_CHAIN_ID=0xaa36a7
# Optional faster RPC for reads (your Alchemy/Infura Sepolia URL); a public node is used if empty:
# VITE_SEPOLIA_RPC_URL=
