# Only needed to deploy to the public Sepolia test network (npm run deploy:sepolia).
# Blockchain/.env is git-ignored — never commit it.

# Your Alchemy (or Infura) Sepolia endpoint, e.g. https://eth-sepolia.g.alchemy.com/v2/<key>
SEPOLIA_RPC_URL=

# Private key of a BRAND-NEW MetaMask account used only for this project (no real money on it).
# This account becomes the platform ADMIN. MetaMask: account menu > Account details > Show private key.
DEPLOYER_PRIVATE_KEY=
