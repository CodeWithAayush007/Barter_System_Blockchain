# Server
PORT=5000
NODE_ENV=development
# Where the website runs (comma-separated list is allowed)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Database — used for sign-in and the activity feed. Trading on the blockchain does NOT need it:
# without MongoDB the API still starts and answers "database not connected" for those features.
# Either a local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/barter_dapp
# or paste your MongoDB Atlas connection string here instead (Database > Connect > Drivers).

# If you hit "querySrv ECONNREFUSED" on Windows (Node's DNS resolver failing
# on SRV lookups even though nslookup/PowerShell work fine — a common
# Node-on-Windows issue, not a code or Atlas problem), you have two options:
#
# 1. Leave MONGODB_URI as your mongodb+srv://... string and just set this to
#    force Node to use a resolver that handles SRV records reliably:
# DNS_SERVERS=8.8.8.8,1.1.1.1
#
# 2. Or avoid SRV lookups entirely: in Atlas, Database > Connect > Drivers,
#    switch the dropdown from "mongodb+srv://" to the standard "mongodb://"
#    string (it lists each shard host directly, e.g.
#    mongodb://user:pass@ac-xxxx-shard-00-00.mongodb.net:27017,ac-xxxx-shard-00-01.mongodb.net:27017,ac-xxxx-shard-00-02.mongodb.net:27017/barter_dapp?ssl=true&replicaSet=atlas-xxxx-shard-0&authSource=admin&retryWrites=true&w=majority)
#    and put that in MONGODB_URI instead — no DNS SRV/TXT lookup needed at all.

# Auth
# Local-development value — use a long random string if you ever deploy this.
JWT_SECRET=local-dev-secret-change-me-before-deploying
JWT_EXPIRES_IN=7d
# How long a signed wallet-auth nonce stays valid, in minutes
NONCE_TTL_MINUTES=10

# Blockchain (read-only — the backend never sends transactions)
# The BarterAgreement address and ABI are written to src/chain/ by
# `npm run deploy:local` in the Blockchain folder, so normally you set nothing.
# CHAIN_RPC_URL=http://127.0.0.1:8545
# AGREEMENT_ADDRESS=0x...

# Photos — stored on Cloudinary (https://cloudinary.com), never on this server's disk.
# Dashboard > Settings > API Keys (or "Go to API Keys" on the Dashboard home). KEEP THE SECRET HERE —
# it must never go into the frontend or into any VITE_ variable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: the Cloudinary folder photos are stored in (default "trove"). If you change it, set the
# same value as VITE_CLOUDINARY_FOLDER in Frontend/.env.
# CLOUDINARY_FOLDER=trove

# Largest accepted photo, in MB
MAX_UPLOAD_MB=5
